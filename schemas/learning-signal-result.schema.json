{
  "$defs": {
    "MetricField": {
      "description": "§10 指标字段名——用于连接器上报\"我这个数据源能提供哪些字段\"。",
      "enum": [
        "VIEWS",
        "WATCH_TIME",
        "AVG_WATCH_TIME",
        "COMPLETION_RATE",
        "LIKES",
        "COMMENTS",
        "SHARES",
        "SAVES",
        "FOLLOWS",
        "IMPRESSIONS",
        "CLICK_THROUGH_RATE"
      ],
      "title": "MetricField",
      "type": "string"
    },
    "SignalBucketStat": {
      "additionalProperties": false,
      "description": "按信号值分桶后，该桶内的相对表现统计。",
      "properties": {
        "enough_samples": {
          "title": "Enough Samples",
          "type": "boolean"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "median_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Relative"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "label",
        "sample_count",
        "enough_samples"
      ],
      "title": "SignalBucketStat",
      "type": "object"
    },
    "SignalDirection": {
      "description": "信号与相对表现的关联方向（**相关**，非因果）。",
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "NONE",
        "INSUFFICIENT"
      ],
      "title": "SignalDirection",
      "type": "string"
    },
    "SignalKind": {
      "description": "§11 可分析的过程信号。",
      "enum": [
        "QA_WARNING_COUNT",
        "MANUAL_EDIT_COUNT",
        "HUMAN_SELECTED",
        "REJECTED_THEN_REVISED",
        "TREND_HOTNESS",
        "PUBLISH_DELAY",
        "DURATION",
        "HAS_MUSIC"
      ],
      "title": "SignalKind",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/learning-signal-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一个信号对某 (age, metric) 相对结局的关联分析结果。\n\n`correlation` 是 Spearman 秩相关 ∈[-1,1]（透明可复现）；`direction` 由相关度 + 阈值 +\n样本量得出；`association_only` 恒 True——**关联非因果**（§11 红线）。",
  "properties": {
    "age_hours": {
      "minimum": 0,
      "title": "Age Hours",
      "type": "number"
    },
    "association_only": {
      "default": true,
      "title": "Association Only",
      "type": "boolean"
    },
    "buckets": {
      "items": {
        "$ref": "#/$defs/SignalBucketStat"
      },
      "title": "Buckets",
      "type": "array"
    },
    "correlation": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation"
    },
    "direction": {
      "$ref": "#/$defs/SignalDirection"
    },
    "enough_samples": {
      "title": "Enough Samples",
      "type": "boolean"
    },
    "metric": {
      "$ref": "#/$defs/MetricField"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "sample_count": {
      "minimum": 0,
      "title": "Sample Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "signal": {
      "$ref": "#/$defs/SignalKind"
    }
  },
  "required": [
    "signal",
    "metric",
    "age_hours",
    "direction",
    "sample_count",
    "enough_samples"
  ],
  "title": "LearningSignalResult",
  "type": "object"
}
