{
  "$defs": {
    "LipSyncEligibilityCriteria": {
      "additionalProperties": false,
      "description": "§10.1 资格阈值（可按模板/模型能力覆盖）。",
      "properties": {
        "max_duration_ms": {
          "default": 30000,
          "exclusiveMinimum": 0,
          "title": "Max Duration Ms",
          "type": "integer"
        },
        "max_faces": {
          "default": 1,
          "description": "允许的最大脸数（单主脸=1）",
          "minimum": 1,
          "title": "Max Faces",
          "type": "integer"
        },
        "max_head_turn_deg": {
          "default": 35.0,
          "maximum": 180.0,
          "minimum": 0.0,
          "title": "Max Head Turn Deg",
          "type": "number"
        },
        "max_occlusion_ratio": {
          "default": 0.2,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Occlusion Ratio",
          "type": "number"
        },
        "min_duration_ms": {
          "default": 400,
          "minimum": 0,
          "title": "Min Duration Ms",
          "type": "integer"
        },
        "min_face_height_ratio": {
          "default": 0.15,
          "description": "面部高度 / 画面高度的最小比（太小 → FACE_TOO_SMALL）",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Face Height Ratio",
          "type": "number"
        },
        "min_speaker_probability": {
          "default": 0.6,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Speaker Probability",
          "type": "number"
        },
        "require_dub_aligned": {
          "default": true,
          "title": "Require Dub Aligned",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "LipSyncEligibilityCriteria",
      "type": "object"
    },
    "LipSyncIneligibleReason": {
      "description": "§10.1 资格不符原因。",
      "enum": [
        "MODE_OFF",
        "NO_PRIMARY_FACE",
        "MULTIPLE_FACES",
        "FACE_TOO_SMALL",
        "OCCLUSION_HIGH",
        "LOW_SPEAKER_PROBABILITY",
        "DURATION_OUT_OF_RANGE",
        "HEAD_TURN_TOO_LARGE",
        "DUB_NOT_ALIGNED"
      ],
      "title": "LipSyncIneligibleReason",
      "type": "string"
    },
    "LipSyncMethod": {
      "description": "一个片段最终的口型处理方式（GPU 合成 + §10.2 回退阶梯）。",
      "enum": [
        "GPU_SYNTHESIS",
        "ORIGINAL_TAKE",
        "BROLL_COVER",
        "FASTER_CUT",
        "KEEP_UNSYNCED"
      ],
      "title": "LipSyncMethod",
      "type": "string"
    },
    "LipSyncMode": {
      "description": "§10.2 口型模式。",
      "enum": [
        "OFF",
        "AUTO_ELIGIBLE",
        "FORCE_REVIEW"
      ],
      "title": "LipSyncMode",
      "type": "string"
    },
    "LipSyncQAReport": {
      "additionalProperties": false,
      "description": "§10.2 合成后一致性 QA（边界、肤色、运动、身份）。分数 ∈ [0,1]，越高越好。",
      "properties": {
        "boundary_score": {
          "description": "脸区边界融合",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Boundary Score",
          "type": "number"
        },
        "identity_score": {
          "description": "身份一致（不换脸）",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Identity Score",
          "type": "number"
        },
        "motion_score": {
          "description": "运动/口型自然",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Motion Score",
          "type": "number"
        },
        "passed": {
          "description": "是否通过 QA（不过则须降级）",
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "skin_tone_score": {
          "description": "肤色一致",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Skin Tone Score",
          "type": "number"
        }
      },
      "required": [
        "boundary_score",
        "skin_tone_score",
        "motion_score",
        "identity_score",
        "passed"
      ],
      "title": "LipSyncQAReport",
      "type": "object"
    },
    "LipSyncReviewReason": {
      "description": "需人工复核的原因（provider 与 domain 都可能置）。",
      "enum": [
        "FORCE_REVIEW",
        "QA_FAILED",
        "SYNTHESIS_FAILED",
        "FALLBACK_USED",
        "KEPT_UNSYNCED"
      ],
      "title": "LipSyncReviewReason",
      "type": "string"
    },
    "LipSyncSegmentDecision": {
      "additionalProperties": false,
      "description": "对一个配音片段的口型决策。\n\n不变量（合同层硬拦）：`GPU_SYNTHESIS` 只能用于合格片段；不合格必须记录原因。",
      "properties": {
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "fallback_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/LipSyncMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "从哪个方式降级来的（自动降级记录）"
        },
        "ineligible_reasons": {
          "items": {
            "$ref": "#/$defs/LipSyncIneligibleReason"
          },
          "title": "Ineligible Reasons",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/LipSyncMethod"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "qa": {
          "anyOf": [
            {
              "$ref": "#/$defs/LipSyncQAReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GPU_SYNTHESIS 已执行时的 QA 报告"
        },
        "rationale": {
          "description": "该决策的原因（人可读）",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "review_reasons": {
          "items": {
            "$ref": "#/$defs/LipSyncReviewReason"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "synthesized_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GPU_SYNTHESIS 成功时的局部脸区产物",
          "title": "Synthesized Artifact Id"
        }
      },
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "eligible",
        "method",
        "rationale"
      ],
      "title": "LipSyncSegmentDecision",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/lipsync-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一次口型同步计划（模式 + 资格阈值 + 逐片段决策）。",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "criteria": {
      "$ref": "#/$defs/LipSyncEligibilityCriteria"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/LipSyncSegmentDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "localization_variant_id": {
      "minLength": 1,
      "title": "Localization Variant Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/LipSyncMode"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "localization_variant_id",
    "mode",
    "created_at"
  ],
  "title": "LipSyncPlan",
  "type": "object"
}
