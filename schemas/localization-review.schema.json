{
  "$defs": {
    "ReviewState": {
      "description": "句级审核状态（§12 人工界面：批准可针对句子）。",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EDITED"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SentenceReviewDecision": {
      "additionalProperties": false,
      "description": "对单句的审核决策。EDITED 必须携带 edited_text。",
      "properties": {
        "edited_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "EDITED 时的新译文；其它状态必须为 None",
          "title": "Edited Text"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "sentence_id": {
          "minLength": 1,
          "title": "Sentence Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ReviewState"
        }
      },
      "required": [
        "sentence_id",
        "state"
      ],
      "title": "SentenceReviewDecision",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/localization-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一个 LocalizationVariant 的句级审核集合。",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/SentenceReviewDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "localization_variant_id": {
      "minLength": 1,
      "title": "Localization Variant Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "localization_variant_id",
    "created_at"
  ],
  "title": "LocalizationReview",
  "type": "object"
}
