{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "可核验陈述（事实层）。必须至少引用一条证据 span（§10.2）。",
      "properties": {
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "evidence": {
          "description": "至少一条证据，禁凭空 Claim",
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "source_status": {
          "$ref": "#/$defs/ClaimSourceStatus",
          "default": "UNVERIFIED"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimSourceStatus": {
      "description": "Claim 的来源核验状态（docs/modules/41 §10.1）。",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "DISPUTED",
        "OPINION"
      ],
      "title": "ClaimSourceStatus",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Claim 的证据来源：引用 transcript 段或 OCR 文本轨的时间片。",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "description": "证据来源类型",
          "pattern": "^(transcript|ocr)$",
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "description": "被引 transcript 段 id 或 TextTrack id",
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ref_id",
        "start_ms",
        "end_ms"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "RhetoricalBeat": {
      "additionalProperties": false,
      "description": "表达层节拍。时间范围由程序候选，kind 由融合分类。",
      "properties": {
        "claim_ids": {
          "description": "本节拍提出的 Claim id",
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RhetoricalBeatKind"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "id",
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "RhetoricalBeat",
      "type": "object"
    },
    "RhetoricalBeatKind": {
      "description": "表达层节拍（docs/modules/41 §10.1）。UNCLASSIFIED 允许存在以保覆盖率。",
      "enum": [
        "HOOK",
        "QUESTION",
        "EVIDENCE",
        "CONTRAST",
        "DEMO",
        "CONCLUSION",
        "CTA",
        "UNCLASSIFIED"
      ],
      "title": "RhetoricalBeatKind",
      "type": "string"
    },
    "VisualBeat": {
      "additionalProperties": false,
      "description": "视觉层节拍（画面功能）。",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "frame_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "代表帧时间",
          "title": "Frame Time Ms"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/VisualBeatKind"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "VisualBeat",
      "type": "object"
    },
    "VisualBeatKind": {
      "description": "视觉层节拍（docs/modules/41 §10.1）。",
      "enum": [
        "PERSON",
        "SCREEN_RECORD",
        "PRODUCT",
        "B_ROLL",
        "CARD",
        "UNKNOWN"
      ],
      "title": "VisualBeatKind",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/video-blueprint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "视频蓝图：事实层 + 表达层 + 视觉层（§10）。经 validate_blueprint 强校验后方可下游消费。",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "coverage": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "rhetorical 节拍时间覆盖率（§10.2 目标 ≥0.9）",
      "title": "Coverage"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "fusion_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fusion Provider"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "rhetorical_beats": {
      "items": {
        "$ref": "#/$defs/RhetoricalBeat"
      },
      "title": "Rhetorical Beats",
      "type": "array"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "source_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Id"
    },
    "visual_beats": {
      "items": {
        "$ref": "#/$defs/VisualBeat"
      },
      "title": "Visual Beats",
      "type": "array"
    }
  },
  "required": [
    "id",
    "duration_ms",
    "created_at"
  ],
  "title": "VideoBlueprint",
  "type": "object"
}
