{
  "$defs": {
    "ExecutionPolicy": {
      "description": "任务路由策略（docs/architecture/30 §6）。",
      "enum": [
        "LOCAL_ONLY",
        "LOCAL_PREFERRED",
        "CLOUD_PREFERRED",
        "CLOUD_ONLY"
      ],
      "title": "ExecutionPolicy",
      "type": "string"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Cores"
        },
        "gpu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_s": {
          "description": "单次尝试的硬超时",
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "integer"
        }
      },
      "required": [
        "timeout_s"
      ],
      "title": "ResourceLimits",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/task-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Worker 领取的任务信封（docs/architecture/30 §5 Task Lease 协议）。",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "capability": {
      "description": "能力标识，如 media.probe / asr.transcribe",
      "minLength": 1,
      "title": "Capability",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "credential_handles": {
      "description": "短期凭据句柄（非凭据本体）",
      "items": {
        "type": "string"
      },
      "title": "Credential Handles",
      "type": "array"
    },
    "execution_policy": {
      "$ref": "#/$defs/ExecutionPolicy",
      "default": "LOCAL_PREFERRED"
    },
    "idempotency_key": {
      "description": "重复提交按 task_id + output_digest 幂等",
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Artifact Ids",
      "type": "array"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "lease_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Id"
    },
    "output_schema_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "产物需满足的 schema 引用，如 schemas/artifact.schema.json",
      "title": "Output Schema Ref"
    },
    "params": {
      "additionalProperties": true,
      "description": "能力专属参数；禁止任何明文凭据字段（用 credential_handles）",
      "title": "Params",
      "type": "object"
    },
    "priority": {
      "default": 0,
      "maximum": 100,
      "minimum": -100,
      "title": "Priority",
      "type": "integer"
    },
    "resource_limits": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceLimits"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "workflow_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Id"
    }
  },
  "required": [
    "task_id",
    "idempotency_key",
    "capability",
    "attempt",
    "created_at"
  ],
  "title": "TaskEnvelope",
  "type": "object"
}
