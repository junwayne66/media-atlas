{
  "$defs": {
    "CalibrationDecision": {
      "description": "校准决策。**故意没有\"全量替换\"值**——最强动作只是 EXPLORE（§11：先离线再少量探索）。",
      "enum": [
        "KEEP_CURRENT",
        "EXPLORE",
        "INSUFFICIENT_SAMPLES"
      ],
      "title": "CalibrationDecision",
      "type": "string"
    },
    "RankerKind": {
      "enum": [
        "TREND_HOT",
        "HIGHLIGHT"
      ],
      "title": "RankerKind",
      "type": "string"
    },
    "RankerWeights": {
      "additionalProperties": false,
      "description": "排序器权重（通用线性表示；系数为 ≥0 幅度——正负号在打分公式里，承接 VF-101）。",
      "properties": {
        "coefficients": {
          "additionalProperties": {
            "type": "number"
          },
          "minProperties": 1,
          "title": "Coefficients",
          "type": "object"
        },
        "ranker_kind": {
          "$ref": "#/$defs/RankerKind"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "template_version": {
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        }
      },
      "required": [
        "ranker_kind",
        "template_version",
        "coefficients"
      ],
      "title": "RankerWeights",
      "type": "object"
    },
    "RankingEvalResult": {
      "additionalProperties": false,
      "description": "一组权重在历史样本上的**离线**排序质量。样本不足或无方差时指标为 null。",
      "properties": {
        "enough_samples": {
          "title": "Enough Samples",
          "type": "boolean"
        },
        "rank_correlation": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank Correlation"
        },
        "ranker_kind": {
          "$ref": "#/$defs/RankerKind"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "template_version": {
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        },
        "top_k": {
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "top_k_hit_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K Hit Rate"
        }
      },
      "required": [
        "ranker_kind",
        "template_version",
        "top_k",
        "sample_count",
        "enough_samples"
      ],
      "title": "RankingEvalResult",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/calibration-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一次校准提案：当前 vs 候选权重 + 双方离线评估 + 决策。\n\n交叉校验把 §11 红线变成合同硬拦：EXPLORE 必须 promotable 且 0<fraction≤max；非 EXPLORE 时\nfraction 必须为 0；不可 promotable 却 EXPLORE；探索比例不得超上限。",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/RankerWeights"
    },
    "candidate_eval": {
      "$ref": "#/$defs/RankingEvalResult"
    },
    "current": {
      "$ref": "#/$defs/RankerWeights"
    },
    "current_eval": {
      "$ref": "#/$defs/RankingEvalResult"
    },
    "decision": {
      "$ref": "#/$defs/CalibrationDecision"
    },
    "exploration_fraction": {
      "maximum": 0.2,
      "minimum": 0,
      "title": "Exploration Fraction",
      "type": "number"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "improvement": {
      "title": "Improvement",
      "type": "number"
    },
    "max_exploration_fraction": {
      "default": 0.2,
      "exclusiveMinimum": 0,
      "maximum": 0.2,
      "title": "Max Exploration Fraction",
      "type": "number"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "promotable": {
      "title": "Promotable",
      "type": "boolean"
    },
    "ranker_kind": {
      "$ref": "#/$defs/RankerKind"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ranker_kind",
    "current",
    "candidate",
    "current_eval",
    "candidate_eval",
    "improvement",
    "promotable",
    "decision",
    "exploration_fraction",
    "generated_at"
  ],
  "title": "CalibrationProposal",
  "type": "object"
}
