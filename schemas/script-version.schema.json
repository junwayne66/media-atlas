{
  "$defs": {
    "RhetoricalBeatKind": {
      "description": "表达层节拍（docs/modules/41 §10.1）。UNCLASSIFIED 允许存在以保覆盖率。",
      "enum": [
        "HOOK",
        "QUESTION",
        "EVIDENCE",
        "CONTRAST",
        "DEMO",
        "CONCLUSION",
        "CTA",
        "UNCLASSIFIED"
      ],
      "title": "RhetoricalBeatKind",
      "type": "string"
    },
    "ScriptSentence": {
      "additionalProperties": false,
      "description": "Canonical Script 的一句：中性语义、逐句可编辑，带估算时长与引用 Claim。",
      "properties": {
        "beat_slot_id": {
          "minLength": 1,
          "title": "Beat Slot Id",
          "type": "string"
        },
        "claim_ids": {
          "description": "本句主张的 Claim 引用",
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/RhetoricalBeatKind"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "target_duration_ms": {
          "description": "按语言语速估算，非字符粗算",
          "minimum": 0,
          "title": "Target Duration Ms",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "beat_slot_id",
        "role",
        "text",
        "target_duration_ms",
        "language"
      ],
      "title": "ScriptSentence",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/script-version.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "可逐句编辑的脚本版本（docs/modules/42 §3.2 第 7 步）。",
  "properties": {
    "beat_template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Beat Template Id"
    },
    "brief_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brief Id"
    },
    "claim_table_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Table Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "language": {
      "minLength": 1,
      "title": "Language",
      "type": "string"
    },
    "rewrite_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rewrite Provider"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "sentences": {
      "items": {
        "$ref": "#/$defs/ScriptSentence"
      },
      "title": "Sentences",
      "type": "array"
    },
    "total_duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Duration Ms"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "language",
    "created_at"
  ],
  "title": "ScriptVersion",
  "type": "object"
}
