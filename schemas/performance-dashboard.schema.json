{
  "$defs": {
    "AccountBaselineEntry": {
      "additionalProperties": false,
      "description": "账号在某 (age, metric) 下的基线统计（中位数/分位数/样本数）。样本为空时统计为 null。",
      "properties": {
        "age_hours": {
          "minimum": 0,
          "title": "Age Hours",
          "type": "number"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "metric": {
          "$ref": "#/$defs/MetricField"
        },
        "p25": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P25"
        },
        "p75": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P75"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "age_hours",
        "metric",
        "sample_count"
      ],
      "title": "AccountBaselineEntry",
      "type": "object"
    },
    "GroupDimension": {
      "description": "§11 分组维度。",
      "enum": [
        "TEMPLATE",
        "HOOK",
        "CREATION_MODE",
        "DURATION_BUCKET",
        "LANGUAGE",
        "PUBLISH_DAYPART"
      ],
      "title": "GroupDimension",
      "type": "string"
    },
    "MetricField": {
      "description": "§10 指标字段名——用于连接器上报\"我这个数据源能提供哪些字段\"。",
      "enum": [
        "VIEWS",
        "WATCH_TIME",
        "AVG_WATCH_TIME",
        "COMPLETION_RATE",
        "LIKES",
        "COMMENTS",
        "SHARES",
        "SAVES",
        "FOLLOWS",
        "IMPRESSIONS",
        "CLICK_THROUGH_RATE"
      ],
      "title": "MetricField",
      "type": "string"
    },
    "PerformanceGroupStat": {
      "additionalProperties": false,
      "description": "某分组（维度=值）在某 (age, metric) 下的**账号内相对指标**统计。\n\n`median_relative` 是组内各视频 `指标/账号基线中位数` 的中位数；`sample_count` 是参与统计的\n（相对值非空）视频数；`enough_samples` 标记是否达到可排序/可信阈值。",
      "properties": {
        "age_hours": {
          "minimum": 0,
          "title": "Age Hours",
          "type": "number"
        },
        "dimension": {
          "$ref": "#/$defs/GroupDimension"
        },
        "enough_samples": {
          "title": "Enough Samples",
          "type": "boolean"
        },
        "median_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Relative"
        },
        "metric": {
          "$ref": "#/$defs/MetricField"
        },
        "p25_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P25 Relative"
        },
        "p75_relative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P75 Relative"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value",
        "age_hours",
        "metric",
        "sample_count",
        "enough_samples"
      ],
      "title": "PerformanceGroupStat",
      "type": "object"
    },
    "PublishPlatform": {
      "enum": [
        "TIKTOK",
        "DOUYIN"
      ],
      "title": "PublishPlatform",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/performance-dashboard.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一个账号在某 (age, metric) 视角下的效果看板：账号基线 + 各维度分组的相对表现。\n\n交叉校验：`median_relative` 非空的分组必须有可用的账号基线中位数（否则相对值无从谈起）。",
  "properties": {
    "account_id": {
      "minLength": 1,
      "title": "Account Id",
      "type": "string"
    },
    "age_hours": {
      "minimum": 0,
      "title": "Age Hours",
      "type": "number"
    },
    "baseline": {
      "$ref": "#/$defs/AccountBaselineEntry"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "group_stats": {
      "items": {
        "$ref": "#/$defs/PerformanceGroupStat"
      },
      "title": "Group Stats",
      "type": "array"
    },
    "metric": {
      "$ref": "#/$defs/MetricField"
    },
    "min_samples": {
      "minimum": 1,
      "title": "Min Samples",
      "type": "integer"
    },
    "platform": {
      "$ref": "#/$defs/PublishPlatform"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "platform",
    "generated_at",
    "age_hours",
    "metric",
    "baseline",
    "min_samples"
  ],
  "title": "PerformanceDashboard",
  "type": "object"
}
