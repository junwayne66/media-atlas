{
  "$defs": {
    "PublishPlatform": {
      "enum": [
        "TIKTOK",
        "DOUYIN"
      ],
      "title": "PublishPlatform",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/snapshot-schedule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一个帖子的快照计划（§10 建议 1/3/6/24/72h/7d，按平台限流调整）。\n\n`planned_ages_hours` 是计划观测的年龄点（小时）；`captured_ages_hours` 是已抓取的年龄点。\ndomain 据 published_at + now 算\"现在该抓哪个/下一个定时器何时触发\"。",
  "properties": {
    "account_id": {
      "minLength": 1,
      "title": "Account Id",
      "type": "string"
    },
    "captured_ages_hours": {
      "items": {
        "type": "number"
      },
      "title": "Captured Ages Hours",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "planned_ages_hours": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Planned Ages Hours",
      "type": "array"
    },
    "platform": {
      "$ref": "#/$defs/PublishPlatform"
    },
    "platform_post_id": {
      "minLength": 1,
      "title": "Platform Post Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "platform",
    "platform_post_id",
    "account_id",
    "published_at",
    "planned_ages_hours"
  ],
  "title": "SnapshotSchedule",
  "type": "object"
}
