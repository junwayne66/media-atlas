{
  "$defs": {
    "MediaProbe": {
      "additionalProperties": false,
      "description": "探测出的媒体技术属性（可选，非媒体 Artifact 无此段）。",
      "properties": {
        "channels": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "time_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "如 1/30000",
          "title": "Time Base"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "title": "MediaProbe",
      "type": "object"
    },
    "ProducedBy": {
      "additionalProperties": false,
      "description": "生成来源：Activity、工具与模型版本（可重放性要求）。",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        }
      },
      "title": "ProducedBy",
      "type": "object"
    },
    "StorageBackend": {
      "enum": [
        "s3",
        "local_cache"
      ],
      "title": "StorageBackend",
      "type": "string"
    },
    "StorageRef": {
      "additionalProperties": false,
      "description": "存储位置。对象键不承载业务真值（docs/architecture/30 §7）。",
      "properties": {
        "backend": {
          "$ref": "#/$defs/StorageBackend"
        },
        "bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bucket"
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "object_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Key"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "backend"
      ],
      "title": "StorageRef",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "不可变产物记录（docs/architecture/30 §7）。同哈希可去重，来源记录不得合并丢失。",
  "properties": {
    "ahash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "均值哈希（docs/architecture/30 §7）",
      "title": "Ahash"
    },
    "audio_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Fingerprint"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "id": {
      "description": "UUIDv7/ULID",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "description": "如 source_video / proxy / render / analysis",
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "media": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaProbe"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mime_type": {
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "phash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "视频感知哈希",
      "title": "Phash"
    },
    "produced_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProducedBy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "retention_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Policy"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "sensitivity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "敏感级别标记",
      "title": "Sensitivity"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "storage": {
      "$ref": "#/$defs/StorageRef"
    },
    "upstream_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Upstream Artifact Ids",
      "type": "array"
    }
  },
  "required": [
    "id",
    "kind",
    "filename",
    "mime_type",
    "size_bytes",
    "sha256",
    "storage",
    "created_at"
  ],
  "title": "Artifact",
  "type": "object"
}
