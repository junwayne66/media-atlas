{
  "$defs": {
    "HighlightCandidate": {
      "additionalProperties": false,
      "description": "一个热门片段候选（docs/modules/42 §5）。时间窗落在句子边界，附特征/评分/理由/人工标签。",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "features": {
          "$ref": "#/$defs/HighlightFeatures"
        },
        "human_label": {
          "$ref": "#/$defs/HighlightLabel",
          "default": "UNREVIEWED"
        },
        "human_label_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "人工选中/放弃原因 → 训练标签",
          "title": "Human Label Reason"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "predicted_retention": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "校准项，无训练数据时为 null，不伪装预测",
          "title": "Predicted Retention"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/HighlightReason"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "description": "加权 highlight_score，可为负（惩罚项占优时）",
          "title": "Score",
          "type": "number"
        },
        "segment_ids": {
          "description": "构成窗口的转录段，句子边界",
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "source_transcript_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Transcript Id"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "weights_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Version"
        }
      },
      "required": [
        "id",
        "start_ms",
        "end_ms",
        "score",
        "features"
      ],
      "title": "HighlightCandidate",
      "type": "object"
    },
    "HighlightFeatures": {
      "additionalProperties": false,
      "description": "单个候选窗口的 11 项特征子分（docs/modules/42 §5.2），各 ∈ [0,1]。由模型判断产出。",
      "properties": {
        "context_dependency": {
          "description": "惩罚项：越高越依赖上下文",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Context Dependency",
          "type": "number"
        },
        "emotional_energy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Emotional Energy",
          "type": "number"
        },
        "ending_payoff": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ending Payoff",
          "type": "number"
        },
        "hook_strength": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hook Strength",
          "type": "number"
        },
        "information_density": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Information Density",
          "type": "number"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "self_containedness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Self Containedness",
          "type": "number"
        },
        "speaker_prominence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Speaker Prominence",
          "type": "number"
        },
        "surprise_or_conflict": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Surprise Or Conflict",
          "type": "number"
        },
        "technical_defect": {
          "description": "惩罚项：越高技术瑕疵越重",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Technical Defect",
          "type": "number"
        },
        "topic_relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Topic Relevance",
          "type": "number"
        },
        "visual_activity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Visual Activity",
          "type": "number"
        }
      },
      "required": [
        "hook_strength",
        "self_containedness",
        "information_density",
        "surprise_or_conflict",
        "emotional_energy",
        "topic_relevance",
        "visual_activity",
        "speaker_prominence",
        "ending_payoff",
        "context_dependency",
        "technical_defect"
      ],
      "title": "HighlightFeatures",
      "type": "object"
    },
    "HighlightLabel": {
      "description": "人工对候选的处置（docs/modules/42 §5.3）。选中/放弃原因成为训练标签。",
      "enum": [
        "UNREVIEWED",
        "SELECTED",
        "REJECTED"
      ],
      "title": "HighlightLabel",
      "type": "string"
    },
    "HighlightReason": {
      "description": "热门片段候选的理由码（docs/modules/42 §5.3）。正向亮点 + 谨慎项。",
      "enum": [
        "HOOK_QUOTE",
        "CLEAR_PAYOFF",
        "HIGH_INFO_DENSITY",
        "SURPRISE",
        "EMOTIONAL_PEAK",
        "SELF_CONTAINED",
        "STRONG_TOPIC",
        "VISUAL_ACTION",
        "CONTEXT_DEPENDENT",
        "TECHNICAL_DEFECT"
      ],
      "title": "HighlightReason",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/highlight-set.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一次热门片段识别的 Top-N 结果集（docs/modules/42 §5.3）。",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/HighlightCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "feature_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feature Provider"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "source_transcript_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Transcript Id"
    },
    "weights_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weights Version"
    }
  },
  "required": [
    "id",
    "created_at"
  ],
  "title": "HighlightSet",
  "type": "object"
}
