{
  "$defs": {
    "ClaimSourceStatus": {
      "description": "Claim 的来源核验状态（docs/modules/41 §10.1）。",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "DISPUTED",
        "OPINION"
      ],
      "title": "ClaimSourceStatus",
      "type": "string"
    },
    "ClaimTableEntry": {
      "additionalProperties": false,
      "description": "ClaimTable 条目（docs/modules/42 §3.2）：事实 + 证据 + 时效 + 置信 + 允许表述。",
      "properties": {
        "allowed_phrasings": {
          "description": "允许的表述方式",
          "items": {
            "type": "string"
          },
          "title": "Allowed Phrasings",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "description": "至少一条证据，禁凭空事实",
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "fact_status": {
          "$ref": "#/$defs/ClaimSourceStatus",
          "default": "UNVERIFIED"
        },
        "recency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "时效标记，如 as_of_2026-07",
          "title": "Recency"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "usable_in_rewrite": {
          "default": true,
          "description": "是否可直接用于改写（DISPUTED 须人工核实）",
          "title": "Usable In Rewrite",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence"
      ],
      "title": "ClaimTableEntry",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Claim 的证据来源：引用 transcript 段或 OCR 文本轨的时间片。",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "description": "证据来源类型",
          "pattern": "^(transcript|ocr)$",
          "title": "Kind",
          "type": "string"
        },
        "ref_id": {
          "description": "被引 transcript 段 id 或 TextTrack id",
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ref_id",
        "start_ms",
        "end_ms"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/claim-table.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "经核验事实表，供结构重写消费。",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ClaimTableEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "source_blueprint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Blueprint Id"
    }
  },
  "required": [
    "id",
    "created_at"
  ],
  "title": "ClaimTable",
  "type": "object"
}
