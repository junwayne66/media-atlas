{
  "$defs": {
    "PublishPlatform": {
      "enum": [
        "TIKTOK",
        "DOUYIN"
      ],
      "title": "PublishPlatform",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/platform-publish-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "平台发布规则集（数据化 §3.1/§3.2/§9 约束，可按平台/账号覆盖）。",
  "properties": {
    "allowed_aspect_ratios": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Aspect Ratios",
      "type": "array"
    },
    "allowed_audio_codecs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Audio Codecs",
      "type": "array"
    },
    "allowed_containers": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Containers",
      "type": "array"
    },
    "allowed_video_codecs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Video Codecs",
      "type": "array"
    },
    "banned_title_chars": {
      "items": {
        "type": "string"
      },
      "title": "Banned Title Chars",
      "type": "array"
    },
    "description_max_len": {
      "minimum": 0,
      "title": "Description Max Len",
      "type": "integer"
    },
    "max_duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Max Duration Ms",
      "type": "integer"
    },
    "max_file_size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Max File Size Bytes",
      "type": "integer"
    },
    "max_height": {
      "exclusiveMinimum": 0,
      "title": "Max Height",
      "type": "integer"
    },
    "max_tags": {
      "minimum": 0,
      "title": "Max Tags",
      "type": "integer"
    },
    "max_width": {
      "exclusiveMinimum": 0,
      "title": "Max Width",
      "type": "integer"
    },
    "min_duration_ms": {
      "minimum": 0,
      "title": "Min Duration Ms",
      "type": "integer"
    },
    "min_height": {
      "exclusiveMinimum": 0,
      "title": "Min Height",
      "type": "integer"
    },
    "min_width": {
      "exclusiveMinimum": 0,
      "title": "Min Width",
      "type": "integer"
    },
    "platform": {
      "$ref": "#/$defs/PublishPlatform"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "tag_max_len": {
      "exclusiveMinimum": 0,
      "title": "Tag Max Len",
      "type": "integer"
    },
    "title_max_len": {
      "exclusiveMinimum": 0,
      "title": "Title Max Len",
      "type": "integer"
    }
  },
  "required": [
    "platform",
    "allowed_aspect_ratios",
    "min_width",
    "min_height",
    "max_width",
    "max_height",
    "allowed_video_codecs",
    "allowed_audio_codecs",
    "allowed_containers",
    "max_file_size_bytes",
    "min_duration_ms",
    "max_duration_ms",
    "title_max_len",
    "description_max_len",
    "max_tags",
    "tag_max_len"
  ],
  "title": "PlatformPublishSpec",
  "type": "object"
}
