{
  "$defs": {
    "CreationMode": {
      "description": "两种二创模式（docs/architecture/31 §5）。",
      "enum": [
        "STRUCTURE_REWRITE",
        "SOURCE_REEDIT"
      ],
      "title": "CreationMode",
      "type": "string"
    },
    "ExecutionPolicy": {
      "description": "任务路由策略（docs/architecture/30 §6）。",
      "enum": [
        "LOCAL_ONLY",
        "LOCAL_PREFERRED",
        "CLOUD_PREFERRED",
        "CLOUD_ONLY"
      ],
      "title": "ExecutionPolicy",
      "type": "string"
    },
    "ProjectStatus": {
      "description": "Project 状态机（docs/architecture/31 §3）。FAILED 不是删除。",
      "enum": [
        "DRAFT",
        "INGESTING",
        "ANALYZING",
        "PLANNING",
        "EDITING",
        "LOCALIZING",
        "QC",
        "REVIEW",
        "APPROVED",
        "PUBLISHING",
        "WAITING_FOR_HUMAN",
        "PUBLISHED",
        "MEASURING",
        "COMPLETED",
        "FAILED"
      ],
      "title": "ProjectStatus",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一条创作任务的业务根（docs/architecture/31 §1.2）。",
  "properties": {
    "budget_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "预算策略引用；超限时进入 WAITING_FOR_BUDGET_APPROVAL",
      "title": "Budget Policy"
    },
    "channel_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Channel Profile Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "creation_mode": {
      "$ref": "#/$defs/CreationMode"
    },
    "execution_policy": {
      "$ref": "#/$defs/ExecutionPolicy",
      "default": "LOCAL_PREFERRED"
    },
    "id": {
      "description": "UUIDv7/ULID，外部不可枚举",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Asset Ids",
      "type": "array"
    },
    "source_language": {
      "description": "BCP-47，如 zh-CN",
      "minLength": 2,
      "title": "Source Language",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProjectStatus",
      "default": "DRAFT"
    },
    "target_languages": {
      "description": "BCP-47 列表",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Languages",
      "type": "array"
    },
    "template_version_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template Version Id"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "trend_cluster_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "来源热点聚类",
      "title": "Trend Cluster Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "description": "乐观并发版本；更新需带 If-Match（51 §1）",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "vertical": {
      "description": "内容方向，如 ai-tech",
      "minLength": 1,
      "title": "Vertical",
      "type": "string"
    },
    "workflow_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Temporal workflow id",
      "title": "Workflow Id"
    }
  },
  "required": [
    "id",
    "title",
    "vertical",
    "source_language",
    "target_languages",
    "creation_mode",
    "created_at",
    "updated_at"
  ],
  "title": "Project",
  "type": "object"
}
