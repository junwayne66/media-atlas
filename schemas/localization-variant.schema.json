{
  "$defs": {
    "ClaimSourceStatus": {
      "description": "Claim 的来源核验状态（docs/modules/41 §10.1）。",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "DISPUTED",
        "OPINION"
      ],
      "title": "ClaimSourceStatus",
      "type": "string"
    },
    "LocalizedSentence": {
      "additionalProperties": false,
      "description": "派生的本地化句：绑到 CanonicalSentence，承载译文 + 引用的 Claim（可能被 diff 变更）。\n\n`needs_review` 由 domain.validate_localization 决定（Claim diff 非空、术语失守、\n低相似度、超时长预算等触发）；provider 层不直接置 True。",
      "properties": {
        "canonical_sentence_id": {
          "minLength": 1,
          "title": "Canonical Sentence Id",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "claim_source_status": {
          "$ref": "#/$defs/ClaimSourceStatus",
          "default": "UNVERIFIED"
        },
        "duration_estimate_ms": {
          "minimum": 0,
          "title": "Duration Estimate Ms",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_similarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Semantic Similarity",
          "type": "number"
        },
        "target_language": {
          "minLength": 1,
          "title": "Target Language",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tra_result_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tra Result Id"
        }
      },
      "required": [
        "id",
        "canonical_sentence_id",
        "target_language",
        "text",
        "duration_estimate_ms",
        "semantic_similarity"
      ],
      "title": "LocalizedSentence",
      "type": "object"
    }
  },
  "$id": "https://videoforge.dev/schemas/localization-variant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一个目标语言的本地化产物：共享 Canonical + Glossary，含逐句 LocalizedSentence。",
  "properties": {
    "canonical_script_id": {
      "minLength": 1,
      "title": "Canonical Script Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "glossary_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Glossary Id"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "sentences": {
      "items": {
        "$ref": "#/$defs/LocalizedSentence"
      },
      "title": "Sentences",
      "type": "array"
    },
    "target_language": {
      "minLength": 1,
      "title": "Target Language",
      "type": "string"
    },
    "total_duration_estimate_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Duration Estimate Ms"
    }
  },
  "required": [
    "id",
    "canonical_script_id",
    "target_language",
    "provider",
    "created_at"
  ],
  "title": "LocalizationVariant",
  "type": "object"
}
