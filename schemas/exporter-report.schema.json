{
  "$defs": {
    "ExportEntry": {
      "additionalProperties": false,
      "description": "单个 Exporter 的输出结果（一份 timeline 可能同时导出到多种 NLE 格式）。",
      "properties": {
        "bytes_written": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Written"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ExporterKind"
        },
        "output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "成功时为绝对路径；FAILED/UNSUPPORTED 时为 null",
          "title": "Output Path"
        },
        "schema_version": {
          "default": "1",
          "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExporterStatus"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "导出器版本，供复现",
          "title": "Tool Version"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "status"
      ],
      "title": "ExportEntry",
      "type": "object"
    },
    "ExporterKind": {
      "description": "时间线导出格式（docs/modules/42 §10）。DaVinci 优先 OTIO/FCPXML；剪映/CapCut 走 Adapter。",
      "enum": [
        "OTIO_FILE",
        "FCPXML",
        "JIANYING",
        "CAPCUT"
      ],
      "title": "ExporterKind",
      "type": "string"
    },
    "ExporterStatus": {
      "description": "单个 Exporter 结果状态（docs/modules/42 §10：失败不阻断 MP4 最终渲染）。",
      "enum": [
        "OK",
        "PARTIAL",
        "FAILED",
        "UNSUPPORTED"
      ],
      "title": "ExporterStatus",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/exporter-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一次导出批次的报告：多 exporter 各自结果 + 时间戳。",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ExportEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "timeline_id": {
      "minLength": 1,
      "title": "Timeline Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "timeline_id",
    "created_at"
  ],
  "title": "ExporterReport",
  "type": "object"
}
