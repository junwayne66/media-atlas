{
  "$defs": {
    "ReviewDecisionKind": {
      "enum": [
        "APPROVED",
        "REJECTED",
        "CHANGES_REQUESTED"
      ],
      "title": "ReviewDecisionKind",
      "type": "string"
    },
    "ReviewScope": {
      "description": "审批对象的粒度（§1.2）。",
      "enum": [
        "VARIANT",
        "PACKAGE",
        "TEMPLATE",
        "PROJECT"
      ],
      "title": "ReviewScope",
      "type": "string"
    }
  },
  "$id": "https://videoforge.dev/schemas/review-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "一次审核决定（§1.2）。绑定到 entity 的具体 version + content_digest。",
  "properties": {
    "content_digest": {
      "description": "被审内容的摘要；内容一改即变 → 旧审批失效",
      "minLength": 1,
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecisionKind"
    },
    "entity_id": {
      "minLength": 1,
      "title": "Entity Id",
      "type": "string"
    },
    "entity_version": {
      "minimum": 1,
      "title": "Entity Version",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "policy_snapshot_id": {
      "minLength": 1,
      "title": "Policy Snapshot Id",
      "type": "string"
    },
    "qc_report_ids": {
      "items": {
        "type": "string"
      },
      "title": "Qc Report Ids",
      "type": "array"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "description": "合同 schema 版本；Reader 需兼容当前与前一版本",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ReviewScope"
    },
    "signature": {
      "description": "无密钥内容绑定摘要（见模块 docstring 安全说明）",
      "minLength": 1,
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "id",
    "decision",
    "scope",
    "entity_id",
    "entity_version",
    "content_digest",
    "reviewer_id",
    "policy_snapshot_id",
    "signature",
    "created_at"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
